import vec.sfmlib

defmac GetTerrainHeight outHeight x y biomeCell

    read mountainHeight biomeCell $BIOME_CELL_MOUNTAIN_HEIGHT
    read hillHeight biomeCell $BIOME_CELL_HILL_HEIGHT
    read riverDepth biomeCell $BIOME_CELL_RIVER_DEPTH
    read riverHeightThreshold biomeCell $BIOME_RIVER_HEIGHT_THRESHOLD
    read heightOffset biomeCell $BIOME_CELL_HEIGHT_OFFSET

    pset mountainRegionFreq 1024
    pset mountainFreq 128
    pset mountainPow 3

    pset hillFreq 64

    pset detailHeight 0.25
    pset detailFreq 8

    pset riverFreq 900
    pset riverPow 13

    #warp coords
    call GetNoiseWarp warp x y 0.1
    call ApplyNoiseWarp lx ly 2 warp x y

    #mountain potency
    call Noise region mountainRegionFreq mountainHeight x y

    #mountain noise
    call PowNoise height mountainFreq region mountainPow lx ly

    #base noise
    call NoiseStep height hillFreq hillHeight lx ly
    call NoiseStep height detailFreq detailHeight lx ly

    #river warp
    op add trx x 100
    call GetNoiseWarp rwarp trx y 0.02
    call ApplyNoiseWarp rx ry 8 rwarp x y

    #river noise
    call RiverNoise river riverFreq riverDepth riverPow rx ry

    #river mask
    call RiverMask riverMask height riverHeightThreshold
    op mul river river riverMask

    #vertical offset
    op sub height height heightOffset

    #apply river
    op add height height river

    #set minimum height to 0
    op min outHeight height 0
end

defmac GetNoiseWarp warp x y mult
    op mul lx x mult 
    op mul ly y mult
    op noise warp lx ly
end

defmac Noise out freq amp x y
    op div lx x freq
    op div ly y freq
    op noise out lx ly
    op mul out out amp
end

defmac PowNoise out freq amp power x y
    op div lx x freq
    op div ly y freq
    op noise out lx ly
    op max out out 0
    op pow out out power
    op mul out out amp
end

defmac RiverNoise out freq amp power x y
    op div lx x freq
    op div ly y freq
    op noise out lx ly
    op abs out out
    op sub out 1 out
    op pow out out power
    op mul out out amp
end

defmac RiverMask out height threshold
    op div out height threshold
    op mul out out -1
    op sub out 1 out
    op min out out 1
    op max out out 0
end

defmac NoiseStep out freq amp x y
    call Noise h freq amp x y
    op add out out h
end

defmac ApplyNoiseWarp lx ly mult warp x y
    op mul lwarp warp mult
    op add lx x lwarp
    op add ly y lwarp
end

defmac RenderTile x y size
    set maxDepth -1
    set depthSum 0
    set minHeight 1000000
    set maxHeight -1000000
    op add markerID2 $markerID 1
    call GetBiome biome x y
    call GetBiomeAll biomeLayers biomeCell biome
    set i 0
    Loop:
        op add ti i 1
        op idiv lx ti 2
        op mod lx lx 2
        op idiv ly i 2
        op mul lx lx size
        op mul ly ly size
        op add lx lx x
        op add ly ly y
        mac GetTerrainHeight lz lx ly biomeCell
        write lz $QUAD_INFO i
        op max maxHeight maxHeight lz
        op min minHeight minHeight lz
        op sub lx lx $PLAYER_X
        op sub ly ly $PLAYER_Y
        op sub lz lz $PLAYER_Z
        mac ApplyRotMatrixOrigin lx ly lz rotX rotY rotZ
        op max maxDepth maxDepth rotZ
        op mul nsize size -1
        jump NoDraw lessThan rotZ nsize
        op max rotZ rotZ 0.01
        mac ProjectPoint drawX drawY rotX rotY rotZ
        mac ToScreenCoords drawX drawY drawX drawY
        op add depthSum depthSum rotZ
        call GetLightRaw light lx ly lz
        write light $QUAD_LIGHT i
        setmarker posi $markerID i drawX drawY
        setmarker posi markerID2 i drawX drawY
    op add i i 1
    jump Loop lessThan i 4
    jump NoDraw lessThan maxDepth 0
    op div avgDepth depthSum 40
    op sub drawLayer 200 avgDepth
    setmarker drawLayer $markerID drawLayer
    setmarker drawLayer markerID2 drawLayer
    setmarker world $markerID true
    setmarker world markerID2 true
    op noise variant x y
    op add variant variant 1
    op mul variant variant 1000000
    op floor variant variant
    call GetTile _ minHeight variant biomeLayers
    setmarker texture $markerID true
    setmarker uvi $markerID 0 0 0
    setmarker uvi $markerID 1 0 1
    setmarker uvi $markerID 2 1 1
    setmarker uvi $markerID 3 1 0
    call GetTile tileHeight maxHeight variant biomeLayers
    setmarker texture markerID2 true
    setmarker uvi markerID2 0 0 0
    setmarker uvi markerID2 1 0 1
    setmarker uvi markerID2 2 1 1
    setmarker uvi markerID2 3 1 0
    set i 0
    FadeLoop:
        read height $QUAD_INFO i
        select alpha lessThan height tileHeight 0 1
        read light $QUAD_LIGHT i
        op mul light light $lightMul
        op add light $skyR light
        packcolor col light light light alpha
        packcolor col2 light light light 1
        setmarker colori $markerID i col2
        setmarker colori markerID2 i col
    op add i i 1
    jump FadeLoop lessThan i 4
    op add $markerID $markerID 2
    op mod $markerID $markerID $MARKER_MAX_ID
    NoDraw:
end

defmac RenderTerrain
    proc
        setrate 800000
        wait 1
        Loop:
            wait 1e-4
            call SetFOV $FOV
            read $markerID $COMM_CELL $COMM_MARKER_ID
            read $PLAYER_X $COMM_CELL $COMM_PLAYER_X
            read $PLAYER_Y $COMM_CELL $COMM_PLAYER_Y
            read $PLAYER_Z $COMM_CELL $COMM_PLAYER_Z
            read skylightCol $COMM_CELL $COMM_SKYLIGHT
            unpackcolor $skyR $skyG $skyB _ skylightCol 
            op sub $lightMul 1 $skyR
            set $stackPointer 0

            call ReadRotMatrix
            call ReadScreenValues
            op floor offsetX $PLAYER_X
            op sub offsetX offsetX $RENDER_DISTANCE
            op floor offsetY $PLAYER_Y
            op sub offsetY offsetY $RENDER_DISTANCE
            RenderLoop:
                jump Exit equal $stackPointer -1
                call ReadStack tileX tileY tileSize
                op div halfTileSize tileSize 2
                op add tileX2 tileX halfTileSize
                op add tileY2 tileY halfTileSize
                op sub distX $PLAYER_X tileX2
                op sub distY $PLAYER_Y tileY2
                op len dist distX distY
                op div dist dist 5
                op max dist dist $MINIMUM_TILE_SIZE
                jump Draw lessThanEq tileSize dist
                    call WriteStack tileX tileY halfTileSize
                    call WriteStack tileX2 tileY halfTileSize
                    call WriteStack tileX tileY2 halfTileSize
                    call WriteStack tileX2 tileY2 halfTileSize
                jump RenderLoopEnd always
                Draw:
                    call RenderTile tileX tileY tileSize
            RenderLoopEnd:
            jump RenderLoop always
            Exit:
            write $markerID $COMM_CELL $COMM_MARKER_ID
            #print $markerID
            #message mission
        jump Loop always
    end
end

defmac TileGetNormal nx ny nz
    read ax $NORM_X 0
    read ay $NORM_Y 0
    read az $NORM_Z 0
    read bx $NORM_X 1
    read by $NORM_Y 1
    read bz $NORM_Z 1
    read cx $NORM_X 2
    read cy $NORM_Y 2
    read cz $NORM_Z 2

    mac VecSub abx aby abz ax ay az bx by bz
    mac VecSub acx acy acz ax ay az cx cy cz
    mac VecCross crossx crossy crossz abx aby abz acx acy acz
    jump NormalFound lessThan crossz 0
    mac VecCross crossx crossy crossz acx acy acz abx aby abz
    NormalFound:
    mac VecNormalize nx ny nz crossx crossy crossz
end

defmac ComputeTileColor color
    mac TileGetNormal nx ny nz
    mac VecDot light nx ny nz $SUN_X $SUN_Y $SUN_Z
    op max light light 0
    op sub tempLight $SUN_LIGHT $AMBIANT_LIGHT
    op mul light light tempLight
    op add light light $AMBIANT_LIGHT
    packcolor color light light light 1
end

defmac GetBiomeStats elevation temperature humidity x y
    pset elevationFreq 0.005
    pset temperatureFreq 0.003
    pset humidityFreq 0.004

    op mul lx x elevationFreq
    op mul ly y elevationFreq
    op noise elevation lx ly

    op mul lx x temperatureFreq
    op add lx lx 1000
    op mul ly y temperatureFreq
    op noise temperature lx ly

    op mul lx x humidityFreq
    op add lx lx 2000
    op mul ly y humidityFreq
    op noise humidity lx ly
end

