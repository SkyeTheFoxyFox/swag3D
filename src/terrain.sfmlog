defmac GetBiomeLayers layers biome
    read x $COMM_CELL $COMM_SCHEM_X
    read y $COMM_CELL $COMM_SCHEM_Y
    op add x x biome
    op sub y y 4
    getblock building layers x y
end

defmac GetBiomeCell cell biome
    read x $COMM_CELL $COMM_SCHEM_X
    read y $COMM_CELL $COMM_SCHEM_Y
    op add x x biome
    op sub y y 5
    getblock building cell x y
end

defmac GetBiomeAll layers cell biome
    read x $COMM_CELL $COMM_SCHEM_X
    read y $COMM_CELL $COMM_SCHEM_Y
    op add x x biome
    op sub y y 4
    getblock building layers x y
    op sub y y 1
    getblock building cell x y
end

defmac GetTile out height variant biomeLayers
    op floor out height 
    op mul h height -1
    op ceil layer h
    lookup block layer layer
    sensor layer layer @name
    read texture biomeLayers layer
    print texture
end